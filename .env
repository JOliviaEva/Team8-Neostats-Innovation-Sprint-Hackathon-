# Environment variables for Team8-Neostats
# Replace placeholder values with real secrets in a secure way before use.

# Server
PORT=3000
NODE_ENV=development

# Database (example for Postgres)
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://postgres:password@localhost:5432/neostats_db

# JWT / Auth
JWT_SECRET=change_me_to_a_strong_secret

# Third-party API keys (placeholders)
STRIPE_API_KEY=pk_test_change_me
SOME_OTHER_API_KEY=change_me

# Local feature flags
ENABLE_FEATURE_X=false
